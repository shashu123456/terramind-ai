{
  "name": "@terramind/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config ./drizzle.config.ts",
    "db:push": "drizzle-kit push --config ./drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config ./drizzle.config.ts"
  },
  "dependencies": {
    "@terramind/core": "workspace:*",
    "@terramind/shared": "workspace:*",
    "drizzle-orm": "^0.44.5",
    "mysql2": "^3.15.0"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "drizzle-kit": "^0.31.4",
    "typescript": "5.9.3"
  }
}