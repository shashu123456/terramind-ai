# =============================================================================
# TerraMind AI — environment configuration
# Copy to `.env` and adjust. Everything works out-of-the-box in demo mode,
# which needs no database, no external AI provider, and no API keys.
# =============================================================================

# ---- Runtime mode -----------------------------------------------------------
# Leave DATABASE_URL blank (or set DEMO_MODE=true) for the self-contained
# offline demo: seeded Northbridge University workspace on a local JSON store.
# Set DATABASE_URL to run against MySQL (see deploy/docker-compose.yml).
DATABASE_URL=

DEMO_MODE=false
DEMO_OWNER_NAME=Chief Sustainability Officer, Northbridge University
DEMO_WORKSPACE_NAME=Northbridge University

# ---- Sessions / auth --------------------------------------------------------
# Used to sign session cookies. DEMO MODE: unset -> a well-known dev secret is
# used (fine for local demos). PRODUCTION: set a long random string.
JWT_SECRET=

# ---- AI copilot ---------------------------------------------------------------
# local  = deterministic local reasoning engine (offline, zero config, default)
# granite  = IBM Granite via any OpenAI-compatible endpoint (watsonx.ai, etc.)
# openai = OpenAI-compatible chat-completions endpoint
# ollama = local Ollama instance (LLM_BASE_URL=http://localhost:11434/v1)
LLM_PROVIDER=local
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- Server ------------------------------------------------------------------
PORT=3000

# ---- Legacy Manus OAuth (optional, production) -------------------------------
# When configured, sign-in additionally offers "Continue with Manus".
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=